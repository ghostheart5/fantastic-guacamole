import 'package:fantastic_guacamole/app/router/app_router.dart';
import 'package:fantastic_guacamole/app/router/route_guards.dart';
import 'package:fantastic_guacamole/app/router/route_paths.dart';
import 'package:fantastic_guacamole/features/monetization/data/models/ai_credit_wallet.dart';
import 'package:fantastic_guacamole/features/monetization/data/models/premium_entitlement.dart';
import 'package:fantastic_guacamole/features/monetization/data/models/subscription_plan.dart';
import 'package:fantastic_guacamole/features/monetization/presentation/screens/paywall_screen.dart';
import 'package:fantastic_guacamole/features/monetization/providers/monetization_feature_providers.dart';
import 'package:fantastic_guacamole/state/core/app_providers.dart';
import 'package:flutter/material.dart';
import 'package:flutter_riverpod/flutter_riverpod.dart';
import 'package:flutter_test/flutter_test.dart';
import 'package:go_router/go_router.dart';
import 'package:shared_preferences/shared_preferences.dart';

void main() {
  TestWidgetsFlutterBinding.ensureInitialized();

  setUp(() {
    SharedPreferences.setMockInitialValues(<String, Object>{});
  });

  ProviderContainer buildContainer() {
    return ProviderContainer(
      overrides: [
        onboardingCompleteGuardProvider.overrideWith((ref) => true),
        onboardingStatusGuardProvider.overrideWith(
          (ref) => OnboardingStatus.complete,
        ),
        authenticatedGuardProvider.overrideWith((ref) => true),
        profileCompleteGuardProvider.overrideWith((ref) => true),
        premiumAccessGuardProvider.overrideWith((ref) => true),
        adminAccessGuardProvider.overrideWith((ref) => true),
        subscriptionPlansProvider.overrideWith((ref) async {
          return const <SubscriptionPlan>[
            SubscriptionPlan(
              id: 'test-premium-monthly',
              name: 'Premium Monthly',
              productId: 'premium_monthly_test',
              planType: 'subscription',
              priceMicros: 9990000,
              currencyCode: 'USD',
              billingPeriod: 'monthly',
              creditsPerPeriod: 250,
              isActive: true,
              description: 'Test premium plan',
            ),
          ];
        }),
        premiumEntitlementProvider.overrideWith((ref) async {
          return const PremiumEntitlement(
            isPremium: false,
            isActive: false,
            planId: 'free',
            source: 'test',
            status: 'free',
          );
        }),
        aiCreditWalletProvider.overrideWith((ref) async {
          return const AiCreditWallet(
            userId: 'test-user',
            balance: 0,
            allowanceRemaining: 0,
            bonusBalance: 0,
            periodCredits: 0,
            lifetimeEarned: 0,
            lifetimeSpent: 0,
            tier: 'free',
          );
        }),
      ],
    );
  }

  Future<GoRouter> pumpRouterApp(
    WidgetTester tester,
    ProviderContainer container,
  ) async {
    final GoRouter router = container.read(appRouterProvider);

    await tester.pumpWidget(
      UncontrolledProviderScope(
        container: container,
        child: MaterialApp.router(routerConfig: router),
      ),
    );

    await tester.pump();
    await tester.pump(const Duration(milliseconds: 250));

    return router;
  }

  Future<void> scrollToPaywallEntry(WidgetTester tester) async {
    final Finder paywallEntry = find.text('Subscription & Paywall');

    if (tester.any(paywallEntry)) {
      return;
    }

    await tester.scrollUntilVisible(
      paywallEntry,
      250,
      scrollable: find.byType(Scrollable).first,
    );

    await tester.pump();
  }

  group('Settings paywall navigation smoke test', () {
    testWidgets('Settings paywall entry opens safely and back returns to Settings', (
      WidgetTester tester,
    ) async {
      final ProviderContainer container = buildContainer();
      addTearDown(container.dispose);

      final GoRouter router = await pumpRouterApp(tester, container);

      router.go(RoutePaths.settings);
      await tester.pump();
      await tester.pump(const Duration(milliseconds: 300));

      expect(router.routeInformationProvider.value.uri.path, RoutePaths.settings);
      expect(tester.takeException(), isNull);

      await scrollToPaywallEntry(tester);

      expect(
        find.text('Subscription & Paywall'),
        findsOneWidget,
        reason: 'Settings should expose the Subscription & Paywall entry.',
      );

      await tester.tap(find.text('Subscription & Paywall'));
      await tester.pump();
      await tester.pump(const Duration(milliseconds: 300));

      expect(
        tester.takeException(),
        isNull,
        reason: 'Opening the paywall/subscription entry should not crash.',
      );

      expect(
        find.byType(PaywallScreen),
        findsOneWidget,
        reason: 'Tapping the Settings paywall entry should show PaywallScreen.',
      );

      await tester.tap(find.byIcon(Icons.arrow_back).last);
      await tester.pump();
      await tester.pump(const Duration(milliseconds: 500));

      expect(
        router.routeInformationProvider.value.uri.path,
        RoutePaths.settings,
        reason: 'Back from Paywall should return to Settings.',
      );

      expect(
        find.text('Subscription & Paywall'),
        findsOneWidget,
        reason: 'Settings should be visible again after returning from Paywall.',
      );

      expect(
        tester.takeException(),
        isNull,
        reason: 'Back from Paywall should not throw.',
      );
    });
  });
}