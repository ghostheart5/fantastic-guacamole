+import 'dart:async';
+
+import 'package:fantastic_guacamole/data/services/local_profile_auth_service.dart';
+import 'package:fantastic_guacamole/data/storage/secure_store.dart';
+import 'package:fantastic_guacamole/features/auth/ui/local_profile_screen.dart';
+import 'package:flutter/material.dart';
+import 'package:flutter_test/flutter_test.dart';
+
+void main() {
+  testWidgets('fresh entry Back is single-flight and cannot create a profile', (
+    WidgetTester tester,
+  ) async {
+    final InMemorySecureStoreBackend backend = InMemorySecureStoreBackend();
+    final LocalProfileAuthService service = _service(backend);
+    final Completer<void> returning = Completer<void>();
+    int returns = 0;
+    await _pumpEntry(tester, service, () async {
+      returns += 1;
+      await returning.future;
+    });
+    addTearDown(() {
+      if (!returning.isCompleted) {
+        returning.complete();
+      }
+    });
+
+    expect(_backScope(tester).canPop, isFalse);
+    await tester.binding.handlePopRoute();
+    await tester.pump();
+    expect(returns, 1);
+    expect(
+      tester
+          .widget<FilledButton>(find.byKey(const Key('local-profile-continue')))
+          .onPressed,
+      isNull,
+    );
+    expect(tester.widget<TextField>(find.byType(TextField)).enabled, isFalse);
+    await tester.binding.handlePopRoute();
+    await tester.pump();
+    expect(returns, 1);
+    expect(await backend.readAll(), isEmpty);
+    expect(service.hasStoredProfile, isFalse);
+    returning.complete();
+    await tester.pumpAndSettle();
+    expect(service.currentUser, isNull);
+  });
+
+  for (final bool deleting in <bool>[false, true]) {
+    testWidgets(
+      '${deleting ? 'pending deletion' : 'closed profile'} never uses first-run Back',
+      (WidgetTester tester) async {
+        final InMemorySecureStoreBackend backend = InMemorySecureStoreBackend();
+        final LocalProfileAuthService service = _service(
+          backend,
+          failDeletion: deleting,
+        );
+        await service.createProfile(displayName: 'Existing local identity');
+        if (deleting) {
+          await expectLater(
+            service.deleteCurrentAccount(password: ''),
+            throwsStateError,
+          );
+        } else {
+          await service.signOut();
+        }
+        final Map<String, String> before = await backend.readAll();
+        int returns = 0;
+        await _pumpEntry(tester, service, () async {
+          returns += 1;
+        });
+        expect(_backScope(tester).canPop, isTrue);
+        expect(
+          find.text(deleting ? 'Retry deletion' : 'Open profile'),
+          findsOneWidget,
+        );
+        await tester.binding.handlePopRoute();
+        await tester.pump();
+        expect(returns, 0);
+        expect(await backend.readAll(), before);
+        expect(service.hasStoredProfile, isTrue);
+        expect(service.hasPendingDeletion, deleting);
+        expect(service.currentUser, isNull);
+      },
+    );
+  }
+
+  testWidgets('Back cannot interrupt creation or reset Welcome while busy', (
+    WidgetTester tester,
+  ) async {
+    final _GatedProfileWriteBackend backend = _GatedProfileWriteBackend();
+    final LocalProfileAuthService service = _service(backend);
+    int returns = 0;
+    await _pumpEntry(tester, service, () async {
+      returns += 1;
+    });
+    addTearDown(backend.finishWrite);
+    await tester.tap(find.byKey(const Key('local-profile-continue')));
+    await tester.pump();
+    expect(find.text('Please wait'), findsOneWidget);
+    expect(_backScope(tester).canPop, isFalse);
+    await tester.binding.handlePopRoute();
+    await tester.pump();
+    expect(returns, 0);
+    expect(service.hasStoredProfile, isFalse);
+    backend.finishWrite();
+    await tester.pumpAndSettle();
+    expect(service.currentUser?.isLocalProfile, isTrue);
+    expect(returns, 0);
+  });
+
+  testWidgets('a failed welcome return leaves fresh profile data untouched', (
+    WidgetTester tester,
+  ) async {
+    final InMemorySecureStoreBackend backend = InMemorySecureStoreBackend();
+    final LocalProfileAuthService service = _service(backend);
+    await _pumpEntry(tester, service, () async {
+      throw StateError('fixture preference write failed');
+    });
+    await tester.binding.handlePopRoute();
+    await tester.pumpAndSettle();
+    expect(
+      find.text(
+        'Welcome could not be reopened. Retry; your local profile has not been changed.',
+      ),
+      findsOneWidget,
+    );
+    expect(find.text('Create a local profile'), findsOneWidget);
+    expect(_backScope(tester).canPop, isFalse);
+    expect(service.currentUser, isNull);
+    expect(await backend.readAll(), isEmpty);
+    expect(
+      tester
+          .widget<FilledButton>(find.byKey(const Key('local-profile-continue')))
+          .onPressed,
+      isNotNull,
+    );
+  });
+}
+
+LocalProfileAuthService _service(
+  SecureStoreBackend backend, {
+  bool failDeletion = false,
+}) => LocalProfileAuthService(
+  store: SecureStore(backend: backend),
+  onBeforeClosed: (_) async {},
+  onProfileDeleted: (_) async {
+    if (failDeletion) {
+      throw StateError('fixture interrupted deletion');
+    }
+  },
+);
+
+Future<void> _pumpEntry(
+  WidgetTester tester,
+  LocalProfileAuthService service,
+  Future<void> Function() onReturnToWelcome,
+) async {
+  await service.initialize();
+  addTearDown(() async {
+    await tester.pumpWidget(const SizedBox.shrink());
+    await tester.pump();
+    await service.dispose();
+  });
+  await tester.pumpWidget(
+    MaterialApp(
+      home: LocalProfileScreen(
+        service: service,
+        onReturnToWelcome: onReturnToWelcome,
+      ),
+    ),
+  );
+  await tester.pumpAndSettle();
+}
+
+PopScope<Object?> _backScope(WidgetTester tester) =>
+    tester.widget<PopScope<Object?>>(find.byType(PopScope<Object?>));
+
+class _GatedProfileWriteBackend extends InMemorySecureStoreBackend {
+  final Completer<void> _write = Completer<void>();
+
+  void finishWrite() {
+    if (!_write.isCompleted) {
+      _write.complete();
+    }
+  }
+
+  @override
+  Future<void> write({required String key, required String value}) async {
+    if (key == LocalProfileAuthService.profileKey) {
+      await _write.future;
+    }
+    await super.write(key: key, value: value);
+  }
+}
