+class _RecordingOnboardingRepository
+    implements IOnboardingPreferencesRepository {
+  _RecordingOnboardingRepository({this.throwOnReset = false});
+  final SharedPreferencesOnboardingRepository _delegate =
+      SharedPreferencesOnboardingRepository();
+  bool throwOnReset;
+  int markWelcomeCalls = 0;
+  int resetWelcomeCalls = 0;
+
+  @override
+  Future<void> markWelcomeComplete() {
+    markWelcomeCalls += 1;
+    return _delegate.markWelcomeComplete();
+  }
+
+  @override
+  Future<void> resetWelcome() async {
+    resetWelcomeCalls += 1;
+    if (throwOnReset) {
+      throw StateError('Injected onboarding repository reset failed.');
+    }
+    await _delegate.resetWelcome();
+  }
+
+  @override
+  Future<void> markOnboardingComplete({required int contentVersion}) async {
+    throw StateError('Back fixture must not complete setup.');
+  }
+
+  @override
+  Future<void> resetFirstSetup() async {
+    throw StateError('Back fixture must not reset first setup.');
+  }
+}
+
+class _RecordingSecureBackend extends InMemorySecureStoreBackend {
+  int writes = 0;
+  int deletes = 0;
+  int clearCalls = 0;
+
+  @override
+  Future<void> write({required String key, required String value}) async {
+    writes += 1;
+    await super.write(key: key, value: value);
+  }
+
+  @override
+  Future<void> delete({required String key}) async {
+    deletes += 1;
+    await super.delete(key: key);
+  }
+
+  @override
+  Future<void> deleteAll() async {
+    clearCalls += 1;
+    await super.deleteAll();
+  }
+}
