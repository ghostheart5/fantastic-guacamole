+Future<void> _waitForLocalFirstRunEntryReady(
+  WidgetTester tester,
+  _RouterHarness harness,
+) async {
+  bool ready() {
+    if (harness.router.routeInformationProvider.value.uri.path !=
+        RoutePaths.login) {
+      return false;
+    }
+    final List<Element> scopes = find
+        .byType(PopScope<Object?>)
+        .evaluate()
+        .toList();
+    if (scopes.length != 1) {
+      return false;
+    }
+    final ModalRoute<dynamic>? route = ModalRoute.of(scopes.single);
+    if (route == null ||
+        !route.isCurrent ||
+        !route.isActive ||
+        (route.animation != null &&
+            route.animation!.status != AnimationStatus.completed)) {
+      return false;
+    }
+    final List<Element> entries = find
+        .byType(LocalProfileScreen)
+        .evaluate()
+        .toList();
+    if (entries.length != 1 ||
+        !identical(ModalRoute.of(entries.single), route)) {
+      return false;
+    }
+    final LocalProfileScreen screen =
+        entries.single.widget as LocalProfileScreen;
+    final LocalProfileAuthService service = harness.container.read(
+      localProfileAuthServiceProvider,
+    );
+    return identical(screen.service, service) &&
+        service.currentUser == null &&
+        !service.hasStoredProfile &&
+        !service.hasPendingDeletion;
+  }
+
+  // Observe actual local initialization/current-route readiness. Never initialize
+  // services, reset preferences or navigate to make the predicate succeed.
+  for (int frame = 0; frame < 40; frame++) {
+    await tester.pump(const Duration(milliseconds: 50));
+    if (ready()) {
+      await tester.pump();
+      if (ready()) {
+        return;
+      }
+    }
+  }
+  fail(
+    'First-run entry did not become ready within 2 seconds.\n'
+    '${_backHarnessDiagnostics(tester, harness)}',
+  );
+}
+
+String _backHarnessDiagnostics(WidgetTester tester, _RouterHarness harness) {
+  final StringBuffer buffer = StringBuffer(
+    'URI: ${harness.router.routeInformationProvider.value.uri}\n',
+  );
+  for (final Type type in <Type>[
+    AuthGate,
+    LocalProfileScreen,
+    OnboardingScreen,
+    PopScope<Object?>,
+  ]) {
+    final List<Element> elements = find
+        .byType(type, skipOffstage: false)
+        .evaluate()
+        .toList();
+    buffer.writeln('$type count=${elements.length}');
+    for (final Element element in elements.take(6)) {
+      final ModalRoute<dynamic>? route = ModalRoute.of(element);
+      buffer.writeln(
+        '  route=${route?.settings.name} id=${route == null ? null : identityHashCode(route)} '
+        'current=${route?.isCurrent} active=${route?.isActive} '
+        'navigator=${route?.navigator != null} animation=${route?.animation?.status}',
+      );
+    }
+  }
+  final String tree =
+      tester.binding.rootElement?.toStringDeep() ?? '<no root element>';
+  buffer.writeln(tree.length > 12000 ? tree.substring(0, 12000) : tree);
+  return buffer.toString();
 }
 
