+Future<void> _waitForWelcomeRouteRetirement(
+  WidgetTester tester,
+  _RouterHarness harness,
+  ModalRoute<dynamic> localEntryRoute,
+) async {
+  bool localEntryRetired = false;
+  unawaited(
+    localEntryRoute.completed.then<void>((_) {
+      localEntryRetired = true;
+    }),
+  );
+  bool ready() {
+    if (harness.router.routeInformationProvider.value.uri.path !=
+        RoutePaths.onboarding) {
+      return false;
+    }
+    final List<Element> welcomes = find
+        .byType(OnboardingScreen)
+        .evaluate()
+        .toList();
+    if (welcomes.length != 1) {
+      return false;
+    }
+    final ModalRoute<dynamic>? route = ModalRoute.of(welcomes.single);
+    return route != null &&
+        route.isCurrent &&
+        route.isActive &&
+        (route.animation == null ||
+            route.animation!.status == AnimationStatus.completed) &&
+        localEntryRetired;
+  }
+
+  // TransitionRoute.completed resolves only after its overlay entries leave.
+  // Keep both original global absence assertions below; URI alone is insufficient.
+  for (int frame = 0; frame < 40; frame++) {
+    await tester.pump(const Duration(milliseconds: 50));
+    if (ready()) {
+      await tester.pump();
+      if (ready()) {
+        return;
+      }
+    }
+  }
+  fail(
+    'Welcome route did not settle and retire the exact login route '
+    'within 2 seconds.\n'
+    'Outgoing completed future: $localEntryRetired\n'
+    'Outgoing login: ${_describeBackRoute(localEntryRoute)}\n'
+    '${_backHarnessDiagnostics(tester, harness)}',
+  );
+}
+
+String _describeBackRoute(ModalRoute<dynamic>? route) {
+  if (route == null) {
+    return '<no ModalRoute>';
+  }
+  return 'name=${route.settings.name} id=${identityHashCode(route)} '
+      'current=${route.isCurrent} active=${route.isActive} '
+      'navigator=${route.navigator != null} '
+      'animation=${route.navigator == null ? 'retired' : route.animation?.status}';
+}
+
+String _backHarnessDiagnostics(WidgetTester tester, _RouterHarness harness) {
+  final StringBuffer buffer = StringBuffer(
+    'URI: ${harness.router.routeInformationProvider.value.uri}\n',
+  );
+  for (final Type type in <Type>[
+    AuthGate,
+    LocalProfileScreen,
+    OnboardingScreen,
+    PopScope<Object?>,
+  ]) {
+    final List<Element> elements = find
+        .byType(type, skipOffstage: false)
+        .evaluate()
+        .toList();
+    buffer.writeln('$type count=${elements.length}');
+    for (final Element element in elements.take(6)) {
+      buffer.writeln('  ${_describeBackRoute(ModalRoute.of(element))}');
+    }
+  }
+  final String tree =
+      tester.binding.rootElement?.toStringDeep() ?? '<no root element>';
+  buffer.writeln(tree.length > 12000 ? tree.substring(0, 12000) : tree);
+  return buffer.toString();
 }
 
