+
+void main() {
+  setUpAll(() {
+    expect(
+      Env.isLocalMode,
+      isTrue,
+      reason:
+          'Select this local-only file with '
+          '--dart-define-from-file=tool/qa_defines.json; never skip it in cloud mode.',
+    );
+  });
+
+  setUp(() {
+    SharedPreferences.setMockInitialValues(<String, Object>{
+      onboardingWelcomeCompleteStorageKey: false,
+      onboardingCompleteStorageKey: false,
+      onboardingContentVersionStorageKey: 1,
+    });
+  });
+
+  testWidgets('real local AuthGate Back preserves protected returnTo intent', (
+    WidgetTester tester,
+  ) async {
+    final _RecordingOnboardingRepository repository =
+        _RecordingOnboardingRepository();
+    final _RouterHarness harness = await _pumpRouter(tester, repository);
+    const String destination =
+        '/timeline?day=2026-08-29&filter=planned#block-7';
+    harness.router.go(destination);
+    await _pumpRouteTransition(tester);
+    _expectReturnTo(harness, RoutePaths.onboarding, destination);
+    expect(find.byType(OnboardingScreen), findsOneWidget);
+
+    await tester.tap(find.text('CONTINUE TO PROFILE'));
+    await _pumpRouteTransition(tester);
+    _expectReturnTo(harness, RoutePaths.login, destination);
+    _expectRealFreshEntry(tester, harness);
+    await _expectWelcomeState(harness, isComplete: true);
+    await _expectNoProfileMutations(harness);
+    final ModalRoute<dynamic> localEntryRoute = ModalRoute.of(
+      tester.element(find.byType(LocalProfileScreen)),
+    )!;
+    expect(localEntryRoute.isCurrent, isTrue);
+
+    await tester.binding.handlePopRoute();
+    await _pumpRouteTransition(tester);
+    await _waitForWelcomeRouteRetirement(tester, harness, localEntryRoute);
+
+    _expectReturnTo(harness, RoutePaths.onboarding, destination);
+    expect(find.byType(OnboardingScreen), findsOneWidget);
+    expect(find.byType(AuthGate), findsNothing);
+    expect(find.byType(LocalProfileScreen), findsNothing);
+    expect(find.text('CONTINUE TO PROFILE'), findsOneWidget);
+    await _expectWelcomeState(harness, isComplete: false);
+    expect(repository.markWelcomeCalls, 1);
+    expect(repository.resetWelcomeCalls, 1);
+    await _expectNoProfileMutations(harness);
+  });
+
+  testWidgets('real AuthGate failed welcome reset stays fresh and can retry', (
+    WidgetTester tester,
+  ) async {
+    final _RecordingOnboardingRepository repository =
+        _RecordingOnboardingRepository(throwOnReset: true);
+    final _RouterHarness harness = await _pumpRouter(tester, repository);
+    await _pumpRouteTransition(tester);
+    await tester.tap(find.text('CONTINUE TO PROFILE'));
+    await _pumpRouteTransition(tester);
+    expect(
+      harness.router.routeInformationProvider.value.uri.path,
+      RoutePaths.login,
+    );
+    _expectRealFreshEntry(tester, harness);
+    await _expectWelcomeState(harness, isComplete: true);
+
+    await tester.binding.handlePopRoute();
+    await _pumpRouteTransition(tester);
+
+    expect(repository.resetWelcomeCalls, 1);
+    expect(
+      harness.router.routeInformationProvider.value.uri.path,
+      RoutePaths.login,
+    );
+    _expectRealFreshEntry(tester, harness);
+    expect(find.byType(OnboardingScreen), findsNothing);
+    expect(
+      find.text(
+        'Welcome could not be reopened. Retry; your local profile has not been changed.',
+      ),
+      findsOneWidget,
