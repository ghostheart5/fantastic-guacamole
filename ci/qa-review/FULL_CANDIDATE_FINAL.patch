+    AuthGate,
+    LocalProfileScreen,
+    OnboardingScreen,
+    PopScope<Object?>,
+  ]) {
+    final List<Element> elements = find
+        .byType(type, skipOffstage: false)
+        .evaluate()
+        .toList();
+    buffer.writeln('$type count=${elements.length}');
+    for (final Element element in elements.take(6)) {
+      final ModalRoute<dynamic>? route = ModalRoute.of(element);
+      buffer.writeln(
+        '  route=${route?.settings.name} id=${route == null ? null : identityHashCode(route)} '
+        'current=${route?.isCurrent} active=${route?.isActive} '
+        'navigator=${route?.navigator != null} animation=${route?.animation?.status}',
+      );
+    }
+  }
+  final String tree =
+      tester.binding.rootElement?.toStringDeep() ?? '<no root element>';
+  buffer.writeln(tree.length > 12000 ? tree.substring(0, 12000) : tree);
+  return buffer.toString();
 }
 
