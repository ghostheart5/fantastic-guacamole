+    await _expectWelcomeState(harness, isComplete: true);
+    await _expectNoProfileMutations(harness);
+    expect(
+      tester
+          .widget<FilledButton>(find.byKey(const Key('local-profile-continue')))
+          .onPressed,
+      isNotNull,
+    );
+    expect(tester.widget<TextField>(find.byType(TextField)).enabled, isTrue);
+    expect(tester.takeException(), isNull);
+
+    // Retry through the same real AuthGate callback after the dependency recovers.
+    repository.throwOnReset = false;
+    await tester.binding.handlePopRoute();
+    await _pumpRouteTransition(tester);
+    expect(repository.resetWelcomeCalls, 2);
+    expect(
+      harness.router.routeInformationProvider.value.uri.path,
+      RoutePaths.onboarding,
+    );
+    expect(find.byType(OnboardingScreen), findsOneWidget);
+    expect(find.text('CONTINUE TO PROFILE'), findsOneWidget);
+    await _expectWelcomeState(harness, isComplete: false);
+    await _expectNoProfileMutations(harness);
+  });
+}
+
+Future<void> _waitForWelcomeRouteRetirement(
+  WidgetTester tester,
+  _RouterHarness harness,
+  ModalRoute<dynamic> localEntryRoute,
+) async {
+  bool localEntryRetired = false;
+  unawaited(
+    localEntryRoute.completed.then<void>((_) {
+      localEntryRetired = true;
+    }),
+  );
+  bool ready() {
+    if (harness.router.routeInformationProvider.value.uri.path !=
+        RoutePaths.onboarding) {
+      return false;
+    }
+    final List<Element> welcomes = find
+        .byType(OnboardingScreen)
+        .evaluate()
+        .toList();
+    if (welcomes.length != 1) {
+      return false;
+    }
+    final ModalRoute<dynamic>? route = ModalRoute.of(welcomes.single);
+    return route != null &&
+        route.isCurrent &&
+        route.isActive &&
+        (route.animation == null ||
+            route.animation!.status == AnimationStatus.completed) &&
+        localEntryRetired;
+  }
+
+  // TransitionRoute.completed resolves only after its overlay entries leave.
+  // Keep both original global absence assertions below; URI alone is insufficient.
+  for (int frame = 0; frame < 40; frame++) {
+    await tester.pump(const Duration(milliseconds: 50));
+    if (ready()) {
+      await tester.pump();
+      if (ready()) {
+        return;
+      }
+    }
+  }
+  fail(
+    'Welcome route did not settle and retire the exact login route '
+    'within 2 seconds.\n'
+    'Outgoing completed future: $localEntryRetired\n'
+    'Outgoing login: ${_describeBackRoute(localEntryRoute)}\n'
+    '${_backHarnessDiagnostics(tester, harness)}',
+  );
+}
+
+String _describeBackRoute(ModalRoute<dynamic>? route) {
+  if (route == null) {
+    return '<no ModalRoute>';
+  }
+  return 'name=${route.settings.name} id=${identityHashCode(route)} '
+      'current=${route.isCurrent} active=${route.isActive} '
+      'navigator=${route.navigator != null} '
+      'animation=${route.navigator == null ? 'retired' : route.animation?.status}';
+}
+
+String _backHarnessDiagnostics(WidgetTester tester, _RouterHarness harness) {
+  final StringBuffer buffer = StringBuffer(
+    'URI: ${harness.router.routeInformationProvider.value.uri}\n',
+  );
+  for (final Type type in <Type>[
+    AuthGate,
+    LocalProfileScreen,
+    OnboardingScreen,
+    PopScope<Object?>,
+  ]) {
+    final List<Element> elements = find
+        .byType(type, skipOffstage: false)
+        .evaluate()
+        .toList();
+    buffer.writeln('$type count=${elements.length}');
+    for (final Element element in elements.take(6)) {
+      buffer.writeln('  ${_describeBackRoute(ModalRoute.of(element))}');
+    }
+  }
+  final String tree =
+      tester.binding.rootElement?.toStringDeep() ?? '<no root element>';
+  buffer.writeln(tree.length > 12000 ? tree.substring(0, 12000) : tree);
+  return buffer.toString();
+}
+
+Future<_RouterHarness> _pumpRouter(
+  WidgetTester tester,
+  _RecordingOnboardingRepository repository,
+) async {
+  tester.view.physicalSize = const Size(1440, 2560);
+  tester.view.devicePixelRatio = 1;
+  addTearDown(tester.view.resetPhysicalSize);
+  addTearDown(tester.view.resetDevicePixelRatio);
+  final _RecordingSecureBackend backend = _RecordingSecureBackend();
+  final LocalProfileAuthService service = LocalProfileAuthService(
+    store: SecureStore(backend: backend),
+    onProfileDeleted: (_) async {
+      throw StateError('Router Back fixture must not delete a profile.');
+    },
+    onBeforeClosed: (_) async {
+      throw StateError('Router Back fixture must not close a profile.');
+    },
+  );
+  addTearDown(service.dispose);
+  await service.initialize();
+  final ProviderContainer container = ProviderContainer(
+    overrides: [
+      authServiceProvider.overrideWithValue(service),
+      localProfileAuthServiceProvider.overrideWithValue(service),
+      onboardingPreferencesRepositoryProvider.overrideWithValue(repository),
+      guards.authenticatedGuardProvider.overrideWithValue(false),
+      guards.onboardingWelcomeCompleteGuardProvider.overrideWith(
+        (Ref ref) => ref.watch(onboardingWelcomeCompleteProvider),
+      ),
+      guards.onboardingCompleteGuardProvider.overrideWith(
+        (Ref ref) => ref.watch(onboardingCompleteProvider),
+      ),
+      intelligenceStateProvider.overrideWithValue(
+        const IntelligenceService().fromRuntime(
+          hasMockSignIn: false,
+          hasAuthenticatedUser: false,
+        ),
+      ),
+      accountStorageScopeProvider.overrideWithValue(
+        const AccountStorageScope.signedOut(),
+      ),
+      profileProvider.overrideWith(_EmptyProfile.new),
+      notificationProvider.overrideWith(_EmptyNotifications.new),
+      goalsProvider.overrideWith(_EmptyGoals.new),
+    ],
+  );
+  addTearDown(() async {
+    await tester.pumpWidget(const SizedBox.shrink());
+    await tester.pump();
+    container.dispose();
+  });
+  final GoRouter router = container.read(appRouterProvider);
+  await tester.pumpWidget(
+    UncontrolledProviderScope(
+      container: container,
+      child: MaterialApp.router(routerConfig: router),
+    ),
+  );
+  return _RouterHarness(
+    container: container,
+    router: router,
+    service: service,
+    backend: backend,
+  );
+}
+
+Future<void> _pumpRouteTransition(WidgetTester tester) async {
+  await tester.pump();
+  await tester.pump(const Duration(milliseconds: 400));
+  await tester.pump();
+}
+
+void _expectRealFreshEntry(WidgetTester tester, _RouterHarness harness) {
+  expect(find.byType(AuthGate), findsOneWidget);
+  expect(find.byType(LocalProfileScreen), findsOneWidget);
+  expect(find.text('Create a local profile'), findsOneWidget);
+  expect(find.textContaining('TESTER ACCESS'), findsNothing);
+  expect(find.text('Open profile'), findsNothing);
+  expect(find.byType(PopScope<Object?>), findsOneWidget);
+  expect(
+    tester.widget<PopScope<Object?>>(find.byType(PopScope<Object?>)).canPop,
+    isFalse,
+  );
+  expect(harness.service.currentUser, isNull);
+  expect(harness.service.hasStoredProfile, isFalse);
+  expect(harness.service.hasPendingDeletion, isFalse);
+}
+
+void _expectReturnTo(_RouterHarness harness, String path, String destination) {
+  final Uri location = harness.router.routeInformationProvider.value.uri;
+  expect(location.path, path);
+  final String? returnTo =
+      location.queryParameters[RouteAccessPolicy.returnToQueryParameter];
+  expect(returnTo, destination);
+  final Uri intent = Uri.parse(returnTo!);
+  expect(intent.path, RoutePaths.timeline);
+  expect(intent.queryParameters, <String, String>{
+    'day': '2026-08-29',
+    'filter': 'planned',
+  });
+  expect(intent.fragment, 'block-7');
+}
+
+Future<void> _expectWelcomeState(
+  _RouterHarness harness, {
+  required bool isComplete,
+}) async {
+  final SharedPreferences prefs = await SharedPreferences.getInstance();
+  expect(harness.container.read(onboardingWelcomeCompleteProvider), isComplete);
+  expect(prefs.getBool(onboardingWelcomeCompleteStorageKey), isComplete);
+  expect(harness.container.read(onboardingCompleteProvider), isFalse);
+  expect(prefs.getBool(onboardingCompleteStorageKey), isFalse);
+  expect(prefs.getInt(onboardingContentVersionStorageKey), 1);
+}
+
+Future<void> _expectNoProfileMutations(_RouterHarness harness) async {
+  expect(harness.backend.writes, 0);
+  expect(harness.backend.deletes, 0);
+  expect(harness.backend.clearCalls, 0);
+  expect(await harness.backend.readAll(), isEmpty);
+  expect(harness.service.currentUser, isNull);
+  expect(harness.service.hasStoredProfile, isFalse);
+}
+
+class _RecordingOnboardingRepository
+    implements IOnboardingPreferencesRepository {
+  _RecordingOnboardingRepository({this.throwOnReset = false});
+  final SharedPreferencesOnboardingRepository _delegate =
+      SharedPreferencesOnboardingRepository();
+  bool throwOnReset;
+  int markWelcomeCalls = 0;
+  int resetWelcomeCalls = 0;
+
+  @override
+  Future<void> markWelcomeComplete() {
+    markWelcomeCalls += 1;
+    return _delegate.markWelcomeComplete();
+  }
+
+  @override
+  Future<void> resetWelcome() async {
+    resetWelcomeCalls += 1;
+    if (throwOnReset) {
+      throw StateError('Injected onboarding repository reset failed.');
+    }
+    await _delegate.resetWelcome();
+  }
+
+  @override
+  Future<void> markOnboardingComplete({required int contentVersion}) async {
+    throw StateError('Back fixture must not complete setup.');
+  }
+
+  @override
+  Future<void> resetFirstSetup() async {
+    throw StateError('Back fixture must not reset first setup.');
+  }
+}
+
+class _RecordingSecureBackend extends InMemorySecureStoreBackend {
+  int writes = 0;
+  int deletes = 0;
+  int clearCalls = 0;
+
+  @override
+  Future<void> write({required String key, required String value}) async {
+    writes += 1;
+    await super.write(key: key, value: value);
+  }
+
+  @override
+  Future<void> delete({required String key}) async {
+    deletes += 1;
+    await super.delete(key: key);
+  }
+
+  @override
+  Future<void> deleteAll() async {
+    clearCalls += 1;
+    await super.deleteAll();
+  }
+}
+
+class _RouterHarness {
+  const _RouterHarness({
+    required this.container,
+    required this.router,
+    required this.service,
+    required this.backend,
+  });
+  final ProviderContainer container;
+  final GoRouter router;
+  final LocalProfileAuthService service;
+  final _RecordingSecureBackend backend;
+}
+
+class _EmptyProfile extends ProfileController {
+  @override
+  ProfileState build() => ProfileState();
+}
