{
  "schemaVersion": "1.0.0",
  "status": "provisional-unvalidated",
  "candidateMetadataRequired": [
    "commitSha",
    "binaryHash",
    "device",
    "os",
    "buildMode",
    "dataset",
    "measurementMethod",
    "warmupPolicy",
    "sampleCount",
    "medianMs",
    "p95Ms",
    "allowedThresholdMs",
    "regressionPercent"
  ],
  "datasets": {
    "empty": "0 user-created records",
    "small": "25 tasks and 50 Timeline events",
    "realistic": "250 tasks and 2,000 Timeline events",
    "heavy": "2,000 tasks and 20,000 Timeline events",
    "extreme": "10,000 tasks and 100,000 Timeline events"
  },
  "tiers": {
    "pr": {
      "execution": "local deterministic contract and pure-workload checks only",
      "candidateDeviceRequired": false,
      "metrics": ["trajectoryCalculation", "progressionRecalculation", "serializationAndQueueHarness"]
    },
    "nightly": {
      "execution": "isolated emulator measurements; no production services",
      "candidateDeviceRequired": true,
      "metrics": ["warmStartup", "nexusFirstRender", "creatorSave", "timelineLoad", "timelineSearch", "timelineLargeListScroll", "trajectoryCalculation", "progressionRecalculation", "syncBacklogDrain", "notificationScheduling", "smartPlannerTimeout", "siConsoleTimeout"]
    },
    "release": {
      "execution": "signed nonproduction candidate on physical device",
      "candidateDeviceRequired": true,
      "metrics": ["coldStartup", "warmStartup", "nexusFirstRender", "creatorSave", "timelineLoad", "timelineSearch", "timelineLargeListScroll", "trajectoryCalculation", "progressionRecalculation", "syncBacklogDrain", "databaseMigration", "memoryGrowth", "frameJank", "backgroundRecovery", "notificationScheduling", "smartPlannerTimeout", "siConsoleTimeout"]
    },
    "soak": {
      "execution": "isolated nonproduction candidate; several-hour device campaign",
      "candidateDeviceRequired": true,
      "scenarios": ["repeatedCreateAndComplete", "repeatedTopLevelNavigation", "repeatedBackgroundForeground", "repeatedSynchronization", "longTimelineScrolling", "notificationProcessing", "offlineQueueAccumulationAndRecovery", "severalHourStability"]
    }
  },
  "provisionalBudgetsMs": {
    "coldStartup": {"p95": 4500, "dataset": "small"},
    "warmStartup": {"p95": 2000, "dataset": "small"},
    "nexusFirstRender": {"p95": 1500, "dataset": "realistic"},
    "creatorSave": {"p95": 500, "dataset": "realistic"},
    "timelineLoad": {"p95": 1500, "dataset": "realistic"},
    "timelineSearch": {"p95": 350, "dataset": "heavy"},
    "timelineLargeListScroll": {"p95": 17, "dataset": "heavy"},
    "trajectoryCalculation": {"p95": 500, "dataset": "heavy"},
    "progressionRecalculation": {"p95": 150, "dataset": "heavy"},
    "syncBacklogDrain": {"p95": 5000, "dataset": "small"},
    "databaseMigration": {"p95": 10000, "dataset": "heavy"},
    "backgroundRecovery": {"p95": 2000, "dataset": "realistic"},
    "notificationScheduling": {"p95": 1000, "dataset": "realistic"},
    "smartPlannerTimeout": {"p95": 25000, "dataset": "small"},
    "siConsoleTimeout": {"p95": 25000, "dataset": "small"}
  },
  "provisionalNonTimeBudgets": {
    "memoryGrowthPercent": 20,
    "jankyFramePercent": 2
  }
}
