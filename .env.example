# ChronoSpark environment configuration.
#
# Copy this file to `.env` before running the app with local configuration:
#
#     cp .env.example .env
#
# `.env` is git-ignored and must never be declared as a Flutter asset. Pass it
# to local debug runs as compile-time configuration instead:
#
#     flutter run --dart-define-from-file=.env
#
# Every key is optional. Blank means "use the built-in default". Values passed
# this way are compiled into the app and must be treated as extractable client
# configuration. Never put a service-role key, private key, signing material,
# or another backend secret in a client `.env`.

# ---------------------------------------------------------------------------
# Backend (Supabase)
# ---------------------------------------------------------------------------
# Leave both blank to run fully offline: Env.isSupabaseConfigured is then false
# and the app uses local storage only. Do not fill these with placeholders —
# a non-empty bogus URL makes the app think Supabase is configured.
# Real shape: https://<project-ref>.supabase.co
CHRONOSPARK_SUPABASE_URL=
CHRONOSPARK_SUPABASE_ANON_KEY=
CHRONOSPARK_ENABLE_CLOUD_SYNC=false

# ---------------------------------------------------------------------------
# Local development / testing switches
# ---------------------------------------------------------------------------
# Mock login exposes an explicit QA-only tester-access action.
CHRONOSPARK_ENABLE_MOCK_LOGIN=false

# Mock mode stubs out external services app-wide.
CHRONOSPARK_ENABLE_MOCK_MODE=false

# Disable paywall gating / grant tester access. Never enable for a release.
CHRONOSPARK_PAYWALL_DISABLED=false
CHRONOSPARK_ENABLE_TESTER_FULL_ACCESS=false

# 'dev' | 'staging' | 'prod'
CHRONOSPARK_APP_FLAVOR=dev

# ---------------------------------------------------------------------------
# Observability
# ---------------------------------------------------------------------------
CHRONOSPARK_VERBOSE_LOGS=
CHRONOSPARK_ENABLE_ANALYTICS=false
CHRONOSPARK_ENABLE_CRASH_REPORTING=false

# ---------------------------------------------------------------------------
# Feature flags
# ---------------------------------------------------------------------------
# Runtime flags come from Firebase Remote Config when enabled.
CHRONOSPARK_ENABLE_RUNTIME_FEATURE_FLAGS=false
# JSON object of local overrides, e.g. {"flowmap_feature_read_path":true}
CHRONOSPARK_REMOTE_CONFIG_JSON=

# ---------------------------------------------------------------------------
# Server endpoints
# ---------------------------------------------------------------------------
# Real shape: https://<your-domain>/ai-proxy
CHRONOSPARK_AI_PROXY_ENDPOINT=
# Optional authenticated endpoint for reporting an offensive AI response.
# Defaults to GhostHeart5 Supabase's /functions/v1/ai-report when Supabase is configured.
CHRONOSPARK_AI_REPORT_ENDPOINT=
# Real shape: https://<your-domain>/verify-receipt
CHRONOSPARK_RECEIPT_VERIFY_ENDPOINT=
# Real shape: https://<your-domain>/account-delete
CHRONOSPARK_ACCOUNT_DELETE_ENDPOINT=

# ---------------------------------------------------------------------------
# Deep links / OAuth
# ---------------------------------------------------------------------------
CHRONOSPARK_OAUTH_REDIRECT_URL=chronospark://auth-callback
CHRONOSPARK_GITHUB_OAUTH_REDIRECT_URL=chronospark://auth-callback

# ---------------------------------------------------------------------------
# App Links / Universal Links verification
# ---------------------------------------------------------------------------
# Real shape: AA:BB:CC:... (release cert SHA-256)
CHRONOSPARK_ANDROID_SHA256_CERT=
# Real shape: 10-character Apple team id
CHRONOSPARK_IOS_TEAM_ID=

# ---------------------------------------------------------------------------
# Release gating
# ---------------------------------------------------------------------------
# When true, Env.productionReadinessIssues() is enforced at startup.
CHRONOSPARK_ENFORCE_PROD_READINESS=false
