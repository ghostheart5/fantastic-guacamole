# Client/runtime values for the Flutter app only.
# Do not put SUPABASE_SECRET_KEY here; keep server secrets in supabase/functions/.env.
CHRONOSPARK_SUPABASE_URL=https://<project-ref>.supabase.co
CHRONOSPARK_SUPABASE_ANON_KEY=<anon-key>
CHRONOSPARK_ENABLE_MOCK_LOGIN=false
# The custom scheme is the safe default until the chronospark.app App Link
# domain and Digital Asset Links file have been published and verified.
CHRONOSPARK_OAUTH_REDIRECT_URL=chronospark://auth-callback
CHRONOSPARK_PASSWORD_RECOVERY_REDIRECT_URL=chronospark://auth-callback
CHRONOSPARK_GITHUB_OAUTH_REDIRECT_URL=chronospark://auth-callback
# Authenticated Edge Function endpoints must use the configured Supabase origin.
CHRONOSPARK_RECEIPT_VERIFY_ENDPOINT=https://<project-ref>.supabase.co/functions/v1/monetization-verify
CHRONOSPARK_AI_PROXY_ENDPOINT=https://<project-ref>.supabase.co/functions/v1/ai-proxy
CHRONOSPARK_ACCOUNT_DELETE_ENDPOINT=https://<project-ref>.supabase.co/functions/v1/account-delete
# For Google Play builds using Play App Signing, use the Play Console App Signing
# certificate SHA256 from Setup > App integrity > App signing > Digital Asset Links JSON.
# For direct sideload/non-Play builds, use the release/upload keystore SHA256.
CHRONOSPARK_ANDROID_SHA256_CERT=<release-cert-sha256>
CHRONOSPARK_IOS_TEAM_ID=<apple-team-id>
